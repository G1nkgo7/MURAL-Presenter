# SenseNova Present deployment configuration
# Copy to .env. Shell variables override this file; CLI flags override both.

# WebUI
STUDIO_LANGUAGE=zh
SENSE_NOVA_LOCAL_HOST=127.0.0.1
SENSE_NOVA_LOCAL_PORT=8001
STUDIO_EDITION=v1
STUDIO_DATA_DIR=./studio/data
# The public repository starts as a UI preview. Set to 0 only after mounting
# the generation Harnesses and Skills documented below.
SENSENOVA_UI_ONLY=1

# External runtimes are intentionally not vendored in this repository.
# SENSENOVA_EXTERNAL_RUNTIME_ROOT=/opt/sensenova-present/runtime
# PPTAGENT_CLEAN_PIPELINE_ROOT=/opt/sensenova-present/runtime/clean-harness
# PPTAGENT_LONG_HORIZON_SKILLS_ROOT=/opt/sensenova-present/runtime/long-horizon-skills
# PPTAGENT_VISUAL_CRAFT_HARNESS_ROOT=/opt/sensenova-present/runtime/visual-craft-harness
# PPTAGENT_VISUAL_CRAFT_SKILL_ROOT=/opt/sensenova-present/runtime/visual-craft-harness/skills/ppt-skill-html
# PPTAGENT_LONG_HORIZON_PRESENTER_SUITE_ROOT=/opt/sensenova-present/runtime/long-horizon-presenter-suite

# Main text/model service (optional override for environment-managed models)
# SENSENOVA_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# SENSENOVA_MODEL_API_KEY=EMPTY
# SENSENOVA_MODEL_NAME=my-multimodal-model

# Optional built-in SenseNova/PPTAgent deployments. Blank entries remain
# visible as named profiles but cannot be dispatched until configured.
# SENSENOVA_FLASH_LITE_V39_BASE_URL=https://model.example/v1
# SENSENOVA_FLASH_LITE_V39_2_BASE_URL=https://model-2.example/v1
# SENSENOVA_FLASH_LITE_V39_3_BASE_URL=https://model-3.example/v1
# SENSENOVA_FLASH_LITE_V39_4_BASE_URL=https://model-4.example/v1
# SENSENOVA_QWEN35_BASE_URL=https://qwen.example/v1
# SENSENOVA_CKPT800_BASE_URL=https://checkpoint.example/v1

# Image generation (OpenAI Images API compatible)
# SENSENOVA_IMAGE_BASE_URL=https://example.com/v1
# SENSENOVA_IMAGE_API_KEY=sk-REPLACE_ME
# SENSENOVA_IMAGE_MODEL=gpt-image-2

# Search (Serper compatible)
# SENSENOVA_SEARCH_BASE_URL=https://google.serper.dev
# SENSENOVA_SEARCH_API_KEY=REPLACE_ME

# Keys referenced by the built-in model registry
# SENSENOVA_ANTHROPIC_BASE_URL=https://tokenhub.sensetime.com
# SENSENOVA_ANTHROPIC_API_KEY=sk-REPLACE_ME
# SENSENOVA_GPT56_API_KEY=sk-REPLACE_ME
# SENSENOVA_KIMI_K3_API_KEY=sk-REPLACE_ME

# Optional read-only trajectory browser.
# STUDIO_TRAJECTORY_ROOTS=/data/runs:/data/evaluation-runs
# STUDIO_TRAJECTORY_NOVA_RAW_ROOTS=/data/nova-raw
# STUDIO_TRAJECTORY_QUERY_CATALOG=/data/queries.jsonl

# Runtime tuning
STUDIO_AGENT_MAX_TOKENS=40960
STUDIO_MAX_PER_MODEL=0
STUDENT_TEMPERATURE=0.3
