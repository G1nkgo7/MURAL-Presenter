# distillation/.env —— 引擎运行所需的密钥/配置模板。
# 用法:复制本文件为 .env 后填入真实值。.env 已被 .gitignore,绝不提交入库。
#
# Studio 每条 deck 会在引擎子进程里加载对应 pipeline 目录下的 .env:
#   current 管线 → 读本仓库 distillation/.env
#   v1.2   管线 → 读同级 ../../distillation/.env(PPTProjectV2/distillation,V2 引擎读自身 ROOT)
# 两套都用到 Opus 时,两处 .env 都要配好 ANTHROPIC_* 。

# ── Anthropic(teacher / Opus 系模型)──────────────────────────
# tokenhub 网关的 Anthropic 兼容端点 + key。默认模型 opus-4.8 走这里。
ANTHROPIC_BASE_URL=https://tokenhub.sensetime.com
ANTHROPIC_API_KEY=sk-REPLACE-with-your-anthropic-key
# (可选)备用 key:主 key 所在渠道整组掉线(503「No available channel under group …」)时,
# 先各 key 直打 /v1/messages 探活,再把上面的 ANTHROPIC_API_KEY 换成能通的那路。
# ANTHROPIC_API_KEY_B=sk-REPLACE-with-a-backup-key

# ── OpenAI 兼容(配图 image_generate / 部分工具)────────────────
OPENAI_BASE_URL=https://tokenhub.sensetime.com/v1
OPENAI_API_KEY=sk-REPLACE-with-your-openai-compatible-key
IMAGE_API_KEY=sk-REPLACE-with-your-image-generation-key
IMAGE_MODEL=gpt-image-2

# ── 文本模型专用凭据(Studio 模型注册表引用)────────────────────
GPT56_API_KEY=sk-REPLACE-with-your-gpt-5.6-family-key
KIMI_K3_API_KEY=sk-REPLACE-with-your-kimi-k3-key

# ── Web 检索(可选)──────────────────────────────────────────
# 编排器/子代理联网查资料用 Serper(google.serper.dev)。不配则跳过检索。
SERPER_API_KEY=REPLACE-with-your-serper-key

# ── 引擎行为(可选,均有默认值)──────────────────────────────
# MODEL:引擎默认 teacher 模型(用 Studio 时按所选模型覆盖;单独用引擎 CLI 时生效)。
# MODEL=claude-opus-4-8
# THINKING / THINK_EFFORT:是否开启 Anthropic 扩展思考及强度(low|medium|high)。
# THINKING=1
# THINK_EFFORT=medium

# 学生模型端点通过 STUDENT_BASE_URL，或 Studio 根目录 .env 中的 SENSENOVA_*_BASE_URL 配置。
