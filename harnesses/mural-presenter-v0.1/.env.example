# Copy this file to .env. It is ignored by git: never commit credentials.
# The Clean Harness loads this file before creating model clients.

# Required: Anthropic-compatible teacher endpoint.  The model value is an example;
# select only a model that is authorized by your endpoint.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://tokenhub.sensetime.com
ANTHROPIC_MODEL=claude-opus-4-7-thinking

# Nova Proxy exact-raw V2 capture. Enable these together for production
# distillation runs. NOVA_PROXY_BASE_URL must include /v1. Raw data is written
# to a separate append-only root and is never deleted by --overwrite/--resume.
# CLEAN_NOVA_RAW_V2=1
# NOVA_PROXY_BASE_URL=http://nova-host:8001/v1
# CLEAN_NOVA_RAW_ROOT=/absolute/path/to/RUN_ROOT
# NOVA_RUN_ID=stable-run-id
# NOVA_HEALTH_TIMEOUT=10
# VISION_BACKEND=nova
# VISION_NOVA_TIMEOUT=600
# VISION_NOVA_MAX_TOKENS=16000

# Optional: image generation. Leave ENABLE_IMAGE_GEN=0 for code-only visuals.
ENABLE_IMAGE_GEN=1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://tokenhub.sensetime.com/v1
IMAGE_MODEL=gpt-image-2-pro-all

# Optional: focused web research and real-image retrieval.
SERPER_API_KEY=

# Runtime paths. Keep generated artifacts outside the source tree in production.
# PIPELINE_PYTHON=/absolute/path/to/python
# Set one root when runs/ and logs/ should share a parent (for example, the
# directory already watched by the trace dashboard). Per-directory values win.
# CLEAN_ARTIFACT_ROOT=/absolute/path/to/dashboard-data
# CLEAN_RUNS_DIR=/absolute/path/to/clean-runs
# CLEAN_LOGS_DIR=/absolute/path/to/clean-logs
# Optional overrides for the two bundled instruction paths. Defaults already
# resolve to ../../skills/mural-presenter-v0.1 from this Harness directory.
# CLEAN_SKILLS_DIR=/absolute/path/to/MURAL-Presenter/skills/mural-presenter-v0.1
# CLEAN_SKILL_NAME=mural-presenter-v0-1
# CLEAN_SKILL_NAME_ZH=mural-presenter-v0-1-zh
# CLEAN_SKILL_NAME_EN=mural-presenter-v0-1-en
# Optional training mode: expose both instruction editions and let the
# Orchestrator's first SKILL.md read lock one edition for that Deck.
# Expose both paths and let the Agent select one on its first SKILL.md read.
CLEAN_MODEL_SELECT_SKILL=1

# infer.py passes its own Python to Agent render commands automatically. Set these
# only when a deployment keeps Chromium shared libraries outside that environment.
# PPT_SKILL_PYTHON=/absolute/path/to/python
# PPT_SKILL_BROWSER_LIB_DIRS=/absolute/lib/dir:/another/lib/dir

# Capacity and liveness. The one-day Deck limit is a last-resort guard, not a
# quality budget. Size Deck workers and render slots to the actual deployment.
CLEAN_CHILD_CONCURRENCY=16
CLEAN_CHILD_POOL_MAX_WORKERS=16
# Optional path override. By default each run creates
# <CLEAN_ARTIFACT_ROOT>/live/<batch>.child-concurrency. It is reread before each
# new delegate_task; already-submitted child agents retain their original wave.
# CLEAN_CHILD_CONCURRENCY_FILE=/shared/live/batch.child-concurrency
# Image/search/fetch calls emitted together are tools, not child agents.
CLEAN_REMOTE_TOOL_CONCURRENCY=6
CLEAN_DECK_TIMEOUT=86400
CLEAN_MODEL_TIMEOUT=600
CLEAN_MAX_TURNS=1000
CLEAN_CHILD_MAX_TURNS=1000
CLEAN_MAX_TOKENS=32000
CLEAN_THINKING=0
# Canonical adaptive-thinking setting.  If unset, THINK_EFFORT is honored for
# backward compatibility; if neither is set the runtime uses medium.
# CLEAN_EFFORT=high
# THINK_EFFORT=medium

# Optional visual and local-render limits.
MAX_VISION_EDGE=1600
# CLEAN_BASH_TIMEOUT=300
# CLEAN_RENDER_JOB_TIMEOUT=1800
# CLEAN_RENDER_CLIENT_TIMEOUT=1860
# CLEAN_RENDER_CLEANUP_GRACE=15
# Optional live Render Broker target. Write a new integer atomically to resize;
# zero pauses new renders while already-active renders finish normally.
# CLEAN_RENDER_CONCURRENCY_FILE=/shared/live/batch.render-concurrency
# CLEAN_RENDER_POOL_MAX_WORKERS=1024
# CLEAN_RENDER_STATUS_FILE=/shared/live/batch.render-status.json
# PPT_RENDER_MAX_PAGES=200
