# MURAL Presenter v1 Shadow：Anthropic/OpenAI 平等使用同一组 MODEL_* 参数。
# MODEL_API_FORMAT、MODEL、MODEL_BASE_URL 未填写时由 runtime/config.py 按 API 格式补全；
# 两种 API 格式共享同一组 Provider 参数。
# 0 关闭模型响应截止；等待正常长生成，仍可主动取消请求并释放槽。
MODEL_TIMEOUT_S=0
# 等待共享模型槽的独立预算；不计入单次 HTTP 的执行时限。
MODEL_QUEUE_TIMEOUT_S=7200
# 并发、共享资源与 MinerU 只从这一个非敏感配置读取。
MURAL_RUNTIME_CONFIG=/mnt/afs/hejiatong/multimodal_design/MURAL-Presenter/configs/runtime.json
MODEL_CONNECT_TIMEOUT_S=60
MODEL_IDLE_TIMEOUT_S=3600
# 独立评审同样可能使用慢速模型；活动请求预算不包含资源排队。
CRITIC_TIMEOUT_S=1800
# 全局硬上限仍保留；具体角色默认再收紧，避免工具规划轮和 Critic 复用长创作预算。
AGENT_MAX_TOKENS=40960
OWNER_MAX_TOKENS=40960
ORCHESTRATOR_MAX_TOKENS=16384
SLIDE_OWNER_MAX_TOKENS=20000
RESEARCH_OWNER_MAX_TOKENS=12000
IMAGE_OWNER_MAX_TOKENS=8192
CRITIC_MAX_TOKENS=8192
TRAINING_SAMPLE_MAX_TOKENS=131072
COMPACT_TRIGGER_RATIO=0.90
COMPACT_TARGET_TOKENS=49152
COMPACT_SUMMARY_TARGET_TOKENS=8192
MODEL_CHANNEL_COOLDOWN_S=120
MODEL_MAX_ATTEMPTS=6
# 默认非流式(0):opus-5 超长 adaptive thinking 下流式会从网关拿到畸形分块(空 thinking/
# 空参 tool),非流式返回完整消息更稳;大 max_tokens 的 SDK 10min 守卫由调用处显式 timeout
# 绕过。需要 WebUI 实时预览时可设 1 单独开流式。
MODEL_STREAMING=0
MODEL_PROMPT_CACHE=1
MODEL_PROMPT_CACHE_MESSAGES=1
MODEL_TEMPERATURE=0.3
# 上下文窗口(输入+输出共享)的 token 上限;agent loop 逼近时在闭合边界压缩历史(BUG-1)。
# 默认 262144 对齐 27B;opus 等更大窗口模型应显式调高。安全余量默认 8192 token。
MODEL_CONTEXT_WINDOW=262144
MODEL_CONTEXT_SAFETY_BUFFER=8192
MURAL_RUN_MODE=inference
MURAL_AUTHORING_PROFILE=auto
