# MURAL Presenter deployment configuration
# Copy to .env. Shell variables override this file; CLI flags override both.

# WebUI
STUDIO_LANGUAGE=zh
SENSE_NOVA_LOCAL_HOST=127.0.0.1
SENSE_NOVA_LOCAL_PORT=8001
STUDIO_EDITION=v1
# Reverse proxy strips this prefix before forwarding; leave empty for root deployment.
STUDIO_BASE_PATH=
STUDIO_DATA_DIR=./studio/data
# The launcher pins PPTAGENT_ENGINE_PYTHON and NORMALIZE_PY to the same
# managed webui/inference/.venv interpreter. Do not point attachment/OCR work
# at a second Python environment.
# Paths default to the current repository. Use absolute paths for overrides.
# MURAL_SECRETS_ENV_PATH=/absolute/path/to/provider.env
# MURAL_RUNTIME_CONFIG=/absolute/path/to/runtime.json
MURAL_RELEASE_POLICY=production
MURAL_ALLOW_DIRTY_RELEASE=0
# macOS only: prevent idle sleep while long generation jobs are running.
# Closing the laptop lid can still suspend the system.
SENSENOVA_KEEP_AWAKE=1

# This repository uses one frozen MURAL Presenter Skill/Harness pair by
# default. The WebUI resolves it from the repository root without keeping another editable
# copy under webui/.
PPTAGENT_PUBLIC_SKILL_KEYS=mural-presenter-v1
PPTAGENT_DEFAULT_SKILL=mural-presenter-v1
PPTAGENT_ENABLE_EXPERIMENTAL=0

# Built-in test models are hidden in the release. Leave this empty unless you
# intentionally maintain an internal registry in studio/app/engine.py.
PPTAGENT_PUBLIC_MODEL_KEYS=

# Main text/model service (optional deployment-managed model).
# A complete URL + name pair adds one independent model to the WebUI; it never
# overwrites or renames another model. You can also add/delete models in WebUI
# -> User -> Model configuration.
# SENSENOVA_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# SENSENOVA_MODEL_API_KEY=EMPTY
# SENSENOVA_MODEL_NAME=my-multimodal-model
# SENSENOVA_MODEL_DISPLAY_NAME=My multimodal model

# Provider defaults belong only in MURAL_SECRETS_ENV_PATH, not this file:
# ANTHROPIC_BASE_URL, ANTHROPIC_API_KEY, ANTHROPIC_API_KEY_FALLBACKS,
# ANTHROPIC_API_CHANNEL_LABELS, ANTHROPIC_CHANNEL_BALANCE=primary-first
# IMAGE_PROVIDER=openai_images, IMAGE_BASE_URL, IMAGE_API_KEY,
# IMAGE_MODEL=gpt-image-2-pro-all, SERPER_BASE_URL, SERPER_API_KEY
# Do not create separate opus-teacher.env / opus5-harness-pool.env files.

# Runtime tuning
# MURAL v1 behavior defaults are loaded from
# ../harnesses/mural-presenter-v1/runtime.env. Values below are deployment or
# user-facing overrides rather than a second behavior contract.
STUDIO_AGENT_MAX_TOKENS=40960
STUDIO_MAX_PER_MODEL=0
STUDENT_TEMPERATURE=0.3
